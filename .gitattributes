# Normalize line endings so a checkout on Windows does not break the build.
* text=auto eol=lf

# gradlew is a POSIX shell script. If Git rewrites it to CRLF on checkout, sh
# fails with "\r: command not found" -- on Linux/macOS/CI always, and in Git
# Bash on Windows too. It must stay LF everywhere.
gradlew text eol=lf

# The Windows batch wrapper is the mirror case: cmd.exe wants CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary -- never touch.
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.png binary
*.webp binary
