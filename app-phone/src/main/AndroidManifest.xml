<?xml version="1.0" encoding="utf-8"?>
<!-- Scaffold placeholder manifest: no product meaning beyond launching the empty activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ADR-025 (as amended 2026-09-17): genai-prompt (via core-ai) transitively brings
        Google's datatransport telemetry stack, whose library manifests declare INTERNET and
        ACCESS_NETWORK_STATE.

        INTERNET is stripped from the merged manifest, so the app cannot open a network
        connection and capture text cannot leave the device. That is the privacy guarantee.

        ACCESS_NETWORK_STATE is deliberately kept. It only lets the app read whether the
        device is connected and cannot transmit anything, and the on-device model download
        appears to need it (the evidence, which is suggestive rather than conclusive, is in
        ADR-025's amendment). The watch app strips both.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
