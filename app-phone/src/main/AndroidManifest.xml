<?xml version="1.0" encoding="utf-8"?>
<!-- Scaffold placeholder manifest: no product meaning beyond launching the empty activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ADR-025: genai-prompt (via core-ai) transitively brings Google's datatransport
        telemetry stack, whose library manifests declare these permissions. Strip them
        from the merged manifest so the app cannot reach the network.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
