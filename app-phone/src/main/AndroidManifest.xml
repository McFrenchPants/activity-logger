<?xml version="1.0" encoding="utf-8"?>
<!--
    The phone app: one activity (MainActivity) hosting the Compose navigation shell, and one
    Application (ActivityLedgerApplication) that owns the process's single capture pipeline.
    RECORD_AUDIO is the app's only requested permission; INTERNET is removed below.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ADR-025 (as amended 2026-09-17): genai-prompt (via core-ai) transitively brings
        Google's datatransport telemetry stack, whose library manifests declare INTERNET and
        ACCESS_NETWORK_STATE.

        INTERNET is stripped from the merged manifest, so the app cannot open a network
        connection and capture text cannot leave the device. That is the privacy guarantee.

        ACCESS_NETWORK_STATE is deliberately kept. It only lets the app read whether the
        device is connected and cannot transmit anything, and the on-device model download
        appears to need it (the evidence, which is suggestive rather than conclusive, is in
        ADR-025's amendment). The watch app strips both.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
        Voice capture (VC1.3). RECORD_AUDIO is the only permission this app asks for, and it is
        requested at the moment the user first taps the microphone, never at launch. It does not
        weaken the privacy guarantee above: INTERNET is still stripped from the merged manifest,
        so audio and transcripts cannot leave the device. Every permission outcome (granted,
        denied, permanently denied) leaves typed capture fully available, so there is no dead end.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".ActivityLedgerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ActivityLedger">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
