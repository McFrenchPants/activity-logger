<?xml version="1.0" encoding="utf-8"?>
<!-- Scaffold placeholder manifest: no product meaning beyond launching the empty activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        ADR-025: applied here too so a later dependency change cannot regress it.
        Google's datatransport telemetry stack declares these permissions in its
        library manifests; strip them from the merged manifest.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name">

        <!--
            false: the watch is a companion. It depends on the phone for
            interpretation and storage (docs/WATCH_SPEC.md).
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
