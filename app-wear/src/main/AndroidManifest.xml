<?xml version="1.0" encoding="utf-8"?>
<!-- Scaffold placeholder manifest: no product meaning beyond launching the empty activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        ADR-025: applied here too so a later dependency change cannot regress it.
        Google's datatransport telemetry stack declares these permissions in its
        library manifests; strip them from the merged manifest.
    -->
    <!--
        Needed by the platform speech recognizer. Declared now so the one-off on-device
        recognizer probe (src/androidTest) can be granted it with `adb shell pm grant`;
        the shipping capture screen will need it too.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Normal permission: haptic feedback on capture state changes. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".WatchApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name">

        <!--
            false: the watch is a companion. It depends on the phone for
            interpretation and storage (docs/WATCH_SPEC.md).
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone acks arrive as Data Layer messages on exactly /capture-ack. -->
        <service
            android:name=".CaptureAckListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/capture-ack" />
            </intent-filter>
        </service>

        <!-- Inexact retry alarm target; only this app's own PendingIntent can reach it. -->
        <receiver
            android:name=".RetryAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
